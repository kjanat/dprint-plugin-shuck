{
	"imports": {
		"@dprint/formatter": "jsr:@dprint/formatter@^0",
		"@kjanat/dreamcli": "jsr:@kjanat/dreamcli@^4",
		"@std/assert": "jsr:@std/assert@^1",
		"@std/path": "jsr:@std/path@^1",
		"@std/toml": "jsr:@std/toml@^1"
	},
	"tasks": {
		"e2e": "deno test --frozen -RWE --allow-run=dprint --allow-net=127.0.0.1 tests/e2e.ts --",
		"check": "deno check --frozen scripts/*.ts tests/*.ts",
		"lint": "deno lint scripts/ tests/",
		"test-cli": "deno test --frozen -RWE --allow-run=cargo scripts/*_test.ts",
		"scripts": "run -s deno:check deno:lint deno:test-cli"
	}
}
